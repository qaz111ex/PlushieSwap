bin/
obj/
dist/
libs/
tools/preview/
tools/__pycache__/
research/__pycache__/
__pycache__/
*.user
*.pyc

# Local editor / tooling state
.vs/
.idea/
*.suo
*.log

# Blender exchange files (regenerated by research/export_for_blender.py)
research/blender/

# 3MF-embedded previews/thumbnails, no script reads them
tools/preview_aux/

# One-off render comparisons and experiment scripts (regenerated on demand)
research/preview/

# Third-party reference mod: contains someone else's binaries, audio and models
# under a licence that does not permit redistribution here.
ScallionMiku-main/

# Thunderstore release output (regenerated by tools/package_release.py)
release/

# Staging files written next to the real assets by build_meshes.py, then renamed into
# place. A crash between the write and the rename leaves them behind, and they are
# partial output rather than sources, so they must never be committed.
assets/*.tmp
assets/*.tmp.png
assets/manifest.json.tmp
